# Application Environment
ENV=dev
PROJECT_NAME=CampusGrid

# Security
SECRET_KEY=change-this-to-a-secure-32-character-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration (PostgreSQL example)
DB=postgresql
DB_USER=campusgrid_user
DB_PASSWORD=campusgrid_secure_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=campusgrid_dev

# Cloud PaaS Database URL (Render / Railway / Supabase / Neon)
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Optional: Local development SQLite database URI
# DATABASE_URI=sqlite:///./campus_grid.db
